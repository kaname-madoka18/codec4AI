+/*
+ * Private callback ABI used by video_loader's bundled FFmpeg build.
+ *
+ * This header is intentionally private.  The bridge is passed through
+ * AVCodecContext.opaque, so unpatched callers and unrelated opaque payloads
+ * are unaffected.
+ */
+#ifndef AVCODEC_VIDEO_LOADER_REFERENCE_GRAPH_H
+#define AVCODEC_VIDEO_LOADER_REFERENCE_GRAPH_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define FF_VIDEO_LOADER_REFERENCE_GRAPH_MAGIC UINT64_C(0x564c524546475231)
+
+typedef void (*FFVideoLoaderReferenceGraphCallback)(
+    void *opaque,
+    int64_t current_sample,
+    const int64_t *references,
+    int reference_count,
+    int displayed
+);
+
+typedef struct FFVideoLoaderReferenceGraphBridge {
+    uint64_t magic;
+    int64_t current_sample;
+    void *opaque;
+    FFVideoLoaderReferenceGraphCallback record;
+    int state_only;
+} FFVideoLoaderReferenceGraphBridge;
+
+static inline FFVideoLoaderReferenceGraphBridge *
+ff_video_loader_reference_graph(void *opaque)
+{
+    FFVideoLoaderReferenceGraphBridge *bridge = opaque;
+
+    if (!bridge || bridge->magic != FF_VIDEO_LOADER_REFERENCE_GRAPH_MAGIC)
+        return NULL;
+    return bridge;
+}
+
+#endif
